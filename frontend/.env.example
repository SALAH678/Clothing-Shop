# =====================================================================
# Frontend environment file
# =====================================================================
# Copy this file to `.env` in this folder — the `app` service in
# compose.yaml loads it with `env_file: ./frontend/.env`.
#
#   Copy-Item frontend/.env.example frontend/.env
#
# `.env` is gitignored, so it is never committed. Only variables prefixed
# with VITE_ are exposed to the browser bundle.

# Base URL of the API. The browser calls this URL directly, so it must be
# reachable from the browser — not the Docker-internal service name.
VITE_API_URL=https://localhost:7146

# Google OAuth client ID, used by the "Sign in with Google" button.
# It is the public half of the OAuth client and must match the API's
# `Authentication:Google:ClientId`. A Google client ID is an identifier,
# not a secret — it is designed to be shipped in browser code.
VITE_GOOGLE_CLIENT_ID=208467321587-q6idulvdc00m97nagqo4prpdr37p0rgi.apps.googleusercontent.com
