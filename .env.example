# =====================================================================
# Docker Compose environment file
# =====================================================================
# Copy this file to `.env` in the same folder — Compose reads `.env`
# automatically and interpolates the values below.
#
#   Copy-Item .env.example .env
#
# `.env` is gitignored, so it is never committed.

# ---------------------------------------------------------------------
# PostgreSQL — runs in its own container, so these values only ever
# apply to that throw-away container. Any values will work; the API's
# connection string is built from them.
# ---------------------------------------------------------------------
DB_USER=clothing_shop
DB_PASSWORD=clothing_shop_password
DB_NAME=clothing_shop_db

# ---------------------------------------------------------------------
# ASP.NET HTTPS certificate password
# ---------------------------------------------------------------------
# Must match the password used when generating the certificate:
#
#   dotnet dev-certs https -ep "$env:USERPROFILE\.aspnet\https\aspnetapp.pfx" -p <password>
#
# If the two differ, the API container fails to start.
PASSWORD=choose-a-certificate-password

# ---------------------------------------------------------------------
# JWT signing key — REQUIRED
# ---------------------------------------------------------------------
# Secret used to sign and validate JWT access tokens (HMAC-SHA256, see
# backend/src/Infrastructure/Options/JwtSettings.cs). Injected by
# compose.yaml as JwtSettings__SecretKey, overriding the "..." placeholder
# in backend/src/Api/appsettings.Development.json.
#
# Requirements:
#   - At least 32 characters (256 bits); startup validation rejects
#     anything shorter.
#   - A long random string — generate with:
#       openssl rand -base64 64
#     or PowerShell:
#       [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Max 256 }))
#
# If missing or too short, the API fails fast at startup and no
# login/refresh flow will work. Keep it secret — anyone holding this key
# can forge access tokens. It has zero signup friction, it just needs to
# exist and be sufficiently random.
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars

# ---------------------------------------------------------------------
# ngrok — REQUIRED
# ---------------------------------------------------------------------
# Chargily has to POST the payment webhook to a public URL, so the API is
# tunnelled through ngrok. You need your own account: a reserved domain can
# only be bound by one ngrok agent at a time, so it cannot be shared.
#
# Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-ngrok-authtoken

# Your reserved/static domain — HOSTNAME ONLY, without the https:// prefix.
#   NGROK_DOMAIN=my-store.ngrok-free.app   ->  https://my-store.ngrok-free.app
NGROK_DOMAIN=your-reserved-domain.ngrok-free.app

# ---------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------
# Recipient of the purchase-notification emails the API sends to the store
# owner. (The SMTP sender credentials themselves come from
# backend/src/Api/appsettings.Development.json.)
EMAILADMIN=store-owner@example.com

# ---------------------------------------------------------------------
# Seq (Structured Logging Dashboard)
# ---------------------------------------------------------------------
# Initial admin credentials for the local Seq web interface (http://localhost:5341).
SEQ_FIRSTRUN_ADMINUSERNAME=admin
SEQ_FIRSTRUN_ADMINPASSWORD=Admin55@

